# Copy to .env for local Docker Compose development. Never commit real values.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_DB=rag_platform
POSTGRES_USER=rag_platform
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+psycopg://rag_platform:change-me-in-local-env@postgres:5432/rag_platform
EMBEDDING_DIMENSIONS=1536

REDIS_URL=redis://redis:6379/0

# Used by later authentication work. Generate a unique value before enabling auth.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Used by the local MinIO service. Replace outside development.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=rag-documents
